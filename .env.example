# GREP_SUMMARY: env-example docker-compose variables grouped-by-module platform context platform-secrets postgres redis clickhouse minio s3 litellm langfuse hermes telegram nginx webnames ssl dns proxy monitoring compose-profiles misc
# STRUCTURE: Platform/Context → Platform secrets → Postgres → PgBouncer → Redis → ClickHouse → MinIO → S3/Backup → LLM Provider API Keys → LiteLLM → Langfuse → Hermes Dashboard → Hermes API → Telegram → Nginx → SSL/DNS (webnames) → Proxy → Monitoring/Observability → Compose Profiles → Misc

# region MODULE_CONTRACT
## @purpose  Env-шаблон для docker compose — единый источник всех переменных окружения для platform-модулей.
##           Канонический документ для локальной разработки и CI тестов.
## @scope    Все compose-переменные, сгруппированные по модулям: postgres, pgbouncer, redis, clickhouse,
##           minio, s3/backup, litellm, langfuse, hermes-agent, telegram, nginx, proxy, monitoring, misc.
## @invariants
##   1. ⚠️ CONSTRAINT-комментарии — единый формат \`# ⚠️ CONSTRAINT: <VAR> must match <regex>\` для всех
##      паролей, встраиваемых в URL без URL-encoding.
##   2. REGEX: ^[A-Za-z0-9._-]+$ — charset constraint для всех URL-безопасных паролей.
##   3. Канонический источник — .env.example. .env — зеркало без документации.
##   4. Каждая переменная определена ровно в одной секции (no duplicate keys).
##   5. Secrets не содержат реальных production-значений — только test-заглушки.
##   6. GENERATED by sync_env_defaults.py — DO NOT EDIT. SoT: platform-env.yaml env_defaults section.
## @rationale Charset constraint предотвращает баг pgbouncer-краша при спецсимволах в POSTGRES_PASSWORD
##           (DevPlan 014 STRESS_TEST_REPORT 2026-07-20). Единый формат упрощает grep-поиск и
##           автоматическую валидацию constraint-покрытия.
## @changes
##   2026-07-21 — TASK-3: добавлены CONSTRAINT-комментарии для POSTGRES_PASSWORD, CLICKHOUSE_PASSWORD,
##               MINIO_ROOT_USER, MINIO_ROOT_PASSWORD, PLATFORM_MASTER_PASSWORD, HERMES_DASHBOARD_PASSWORD
##   2026-07-22 — Добавлен WEBNAMES_API_KEY (SSL/DNS Challenge секция) для acme.sh DNS-01 wildcard TLS
##   2026-07-26 — Plan 082: auto-generated from platform-env.yaml + secret-definitions.yaml
# endregion MODULE_CONTRACT

# ══════════════════════════════════════════════════════════════════════════════
# .env.example — переменные окружения для docker compose
# ══════════════════════════════════════════════════════════════════════════════
# Назначение: шаблон для локальной разработки и тестов.
# Копировать: cp .env.example .env (НЕ коммитить .env!)
# Используется: core/modules/*/docker-compose.base.yml + CI workflow platform-test.yml
#
# ⚠️ GENERATED by sync_env_defaults.py — DO NOT EDIT MANUALLY.
#    SoT: platform-env.yaml env_defaults section + secret-definitions.yaml.
#    Регенерация: make sync-env-defaults
# ══════════════════════════════════════════════════════════════════════════════

# ── Platform / Context ─────────────────────────────────────────────────────
# Контекст (GitHub org) для изоляции окружения
CONTEXT=test
# Имя ноды (для деплоя и алертов)
NODE_NAME=test-node
# PLATFORM_DOMAIN — домен платформы для dev-сертификатов и vhost-роутинга.
# Базовое значение: ai-platform.local. При загруженном контексте (context = GitHub org):
#   PLATFORM_DOMAIN=<context>.local, SAN дополнительно включает *.${PLATFORM_DOMAIN}.
# Сертификаты генерируются автоматически через dev_cert_generator.py (make dev-certs).
# @domain-scheme DevPlan 012 — legacy-тестовый домен упразднён.
PLATFORM_DOMAIN=ai-platform.local
# ⚠️ Pin to a specific version — avoid float tag (W7 fix).
# Update this tag when you want to use a newer context overlay image.
# Available tags: ghcr.io/<context>/hermes-agent-context
CONTEXT_IMAGE=ghcr.io/tronyxlab/hermes-agent-context:v2026.7.1
# ── Platform secrets ───────────────────────────────────────────────────────
# Master credentials — unified auth for all platform services (status-page, Prometheus, Loki, Grafana, Langfuse, Hermes).
# Overridable per-service via service-specific env var (e.g. GF_SECURITY_ADMIN_PASSWORD overrides PLATFORM_MASTER_PASSWORD for Grafana).
# ⚠️ NOT for production — set via SOPS/age encrypted secrets on VPS.
# ⚠️ CONSTRAINT: PLATFORM_MASTER_PASSWORD must match ^[A-Za-z0-9._-]+$
# Unified auth: все сервис-пароли (HERMES_DASHBOARD_PASSWORD, GF_SECURITY_ADMIN_PASSWORD,
# LANGFUSE_INIT_USER_PASSWORD) инициализируются из PLATFORM_MASTER_PASSWORD через secrets-init.sh.
# Сервис-пользователи (HERMES_DASHBOARD_USERNAME, GF_SECURITY_ADMIN_USER, LANGFUSE_INIT_USER_EMAIL)
# инициализируются из PLATFORM_MASTER_EMAIL (admin@PLATFORM_DOMAIN) через secrets-init.sh.
# Любая переменная может быть переопределена явно — operator-defined значения сохраняются.
# Генерация: openssl rand -base64 32
PLATFORM_MASTER_EMAIL=admin@ai-platform.local
PLATFORM_MASTER_PASSWORD=test-master-password

# AGE_SECRET_KEY — master age-key для SOPS-расшифровки platform-secrets.
# ⚠️ REQUIRED (env_requires of platform-secrets module) — без него systemd oneshot fails-closed.
# Генерация: age-keygen -o keys.txt → извлечь публичный/приватный ключ
# ⚠️ NOT for production .env — только SOPS-encrypted secrets на VPS.
# ⚠️ CONSTRAINT: AGE_SECRET_KEY must match ^AGE-SECRET-KEY-[A-Za-z0-9]+$
AGE_SECRET_KEY=AGE-SECRET-KEY-TEST1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ── Postgres (shared-db) ───────────────────────────────────────────────────
POSTGRES_USER=postgres
# ⚠️ CONSTRAINT: POSTGRES_PASSWORD must match ^[A-Za-z0-9._-]+$
# Пароль встраивается в DATABASE_URL/DATABASE_URLS без URL-encoding. Генерация: openssl rand -hex 32
POSTGRES_PASSWORD=test-pg-pwd
POSTGRES_DB=platform
# Postgres через pgbouncer (default: 6432)
POSTGRES_PORT=6432
POSTGRES_HOST=pgbouncer

# ── PgBouncer (connection pooler for Postgres) ─────────────────────────────
PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.25.2-p0

# ── Redis (cache) ──────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_HOST=redis

# ── ClickHouse (Analytical DB) ─────────────────────────────────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
# ⚠️ CONSTRAINT: CLICKHOUSE_PASSWORD must match ^[A-Za-z0-9._-]+$
# Пароль встраивается в CLICKHOUSE_MIGRATION_URL без URL-encoding. Генерация: openssl rand -hex 32
CLICKHOUSE_PASSWORD=test-clickhouse-pwd-not-for-prod
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ── MinIO (local S3, dev) ────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# ⚠️ REQUIRED (env_requires of minio module) — no defaults in production; set via SOPS secrets
# ⚠️ CONSTRAINT: MINIO_ROOT_USER must match ^[A-Za-z0-9._-]+$
MINIO_ROOT_USER=minioadmin
# ⚠️ REQUIRED (env_requires of minio module) — no defaults in production; set via SOPS secrets
# ⚠️ CONSTRAINT: MINIO_ROOT_PASSWORD must match ^[A-Za-z0-9._-]+$
MINIO_ROOT_PASSWORD=minioadmin

# ── S3 / Backup ──────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_PREFIX=platform/backups
S3_BUCKET=test-bucket
S3_ACCESS_KEY=test-access-key
S3_SECRET_KEY=test-secret-key
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
PLATFORM_CONTEXT=personal

# ── LLM Provider API Key ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-placeholder-key-for-ci

# ── LiteLLM (LLM Gateway) ────────────────────────────────────────────────────
# ⚠️ LITELLM_MASTER_KEY — ОБЯЗАТЕЛЕН для production. Без него LiteLLM стартует
#    но все API-запросы требующие авторизации будут отклонены (401).
#    Генерировать: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-ci-test-master-key
# Опциональная лицензия (оставить пустым для community-версии)
LITELLM_LICENSE=
LITELLM_PORT=4000
# URL для healthcheck LiteLLM (default: http://litellm:4000/health)
LITELLM_HEALTH_URL=http://litellm:4000/health
# Клиенты (Hermes, внешние тулы) шлют запросы через LiteLLM
OPENAI_BASE_URL=http://litellm:4000
# Virtual key for Hermes-agent — provisioned by make provision-llm (unlimited profile)
LITELLM_API_KEY=sk-placeholder-litellm-api-key

# ── Langfuse (LLM Tracing) ───────────────────────────────────────────────────
NEXTAUTH_SECRET=ci-test-nextauth-secret-32-chars-min!!
NEXTAUTH_URL=http://langfuse:3000
SALT=ci-test-salt-value
# Headless init — ТРЕБУЕТСЯ только при ПЕРВОМ запуске Langfuse.
# После инициализации эти переменные можно удалить из secrets.env.
# Генерировать:
#   LANGFUSE_INIT_ORG_ID:      echo "org_$(openssl rand -hex 4)"
#   LANGFUSE_INIT_PROJECT_ID:  echo "proj_$(openssl rand -hex 4)"
#   LANGFUSE_PUBLIC_KEY:       echo "pk-lf_$(openssl rand -hex 16)"
#   LANGFUSE_SECRET_KEY:       echo "sk-lf_$(openssl rand -hex 16)"
# · Headless init: эти же ключи передаются в langfuse как LANGFUSE_INIT_PROJECT_*
# · Источник: https://langfuse.com/self-hosting/administration/headless-initialization
LANGFUSE_INIT_ORG_ID=ci-test-org
LANGFUSE_INIT_PROJECT_ID=ci-test-project
LANGFUSE_INIT_USER_EMAIL=admin@ai-platform.local
LANGFUSE_INIT_USER_PASSWORD=ci-test-langfuse-pwd
# ⚠️ LANGFUSE_PUBLIC_KEY и LANGFUSE_SECRET_KEY — генерируются после init
LANGFUSE_PUBLIC_KEY=ci-test-public-key
LANGFUSE_SECRET_KEY=ci-test-secret-key
LANGFUSE_PORT=3001
# S3 для Langfuse event-логов (bucket и path-style)
LANGFUSE_S3_BUCKET=langfuse-events
LANGFUSE_S3_FORCE_PATH_STYLE=true

# ── Hermes Agent — Dashboard ──────────────────────────────────────────────
# Boolean — включает/выключает dashboard UI (default: false)
HERMES_DASHBOARD=false
HERMES_DASHBOARD_USERNAME=admin@ai-platform.local
# ⚠️ CONSTRAINT: HERMES_DASHBOARD_PASSWORD must match ^[A-Za-z0-9._-]+$
# Инициализируется из PLATFORM_MASTER_PASSWORD через secrets-init.sh (если не задан явно)
HERMES_DASHBOARD_PASSWORD=test-db-pwd
# 🔗 Цепочка: HERMES_DASHBOARD_USERNAME/PASSWORD → compose (hermes-agent:110-111)
#    → контейнерные BASIC_AUTH_USERNAME / BASIC_AUTH_PASSWORD.
#    Переменные HERMES_DASHBOARD_BASIC_AUTH_* УДАЛЕНЫ — они не потребляются ни одним
#    compose-сервисом. Единственный consumer Basic Auth — сам Hermes Agent Dashboard.
#    nginx-модуль не использует эти переменные; htpasswd в nginx только для Prometheus/Loki.
# Dashboard UI порт (default: 9119)
HERMES_DASHBOARD_PORT=9119
# Десктопный порт Hermes Agent (default: 8642)
HERMES_DESKTOP_PORT=8642

# ── Hermes Agent — API Server ─────────────────────────────────────────────
# Встроенный HTTP API-сервер Hermes Agent.
# Генерировать ключ: openssl rand -hex 32
API_SERVER_ENABLED=false
API_SERVER_KEY=test-api-server-key-for-ci-only
API_SERVER_HOST=0.0.0.0

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token для Hermes Agent и Grafana Alerting
TELEGRAM_BOT_TOKEN=1234567890:test-telegram-bot-token-for-ci
# Разрешённые пользователи (user IDs, comma-separated)
TELEGRAM_ALLOWED_USERS=
# Чат для критических алертов
TELEGRAM_CHAT_ID_CRITICAL=
# Чат для warning-алертов (можно совпадать с CRITICAL)
TELEGRAM_CHAT_ID_WARNING=

# ── Nginx (Edge) ──────────────────────────────────────────────────────────
# Директория конфигурации nginx.
# Локальный стек: dev-config (Docker-DNS upstreams + mkcert TLS).
# Путь резолвится относительно core/modules/nginx/ (include-семантика compose).
#   docker compose config: source → .../core/modules/nginx/dev-config/nginx.conf ✓
# config/ требует letsencrypt-сертификаты (VPS) — не работает локально.
NGINX_CONF_DIR=./dev-config
# NGINX_CERT_DIR — директория TLS-сертификатов (Let's Encrypt).
# VPS: не задавать (default "/etc/letsencrypt", смонтирован в контейнер).
# Локально: ./dev-certs (macOS Docker Desktop не шарит /etc).
NGINX_CERT_DIR=./dev-certs
# NGINX_OVERLAY_DIR — каталог overlay-vhosts из node-configs.
# VPS: /opt/node-configs/<node>/overlays/nginx (см. add-vhost.sh конвенцию).
# Локально не задавать — default "./overlays" пустой и не влияет.
# Конвенция сиблингов: плоский каталог *.conf (глубина 1, non-recursive include).
NGINX_OVERLAY_DIR=
# HTTP/HTTPS порты nginx (default: 80/443; кастомные для dev-окружения без sudo)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_EXPORTER_PORT=9113

# ── SSL / DNS Challenge (acme.sh) ──────────────────────────────────────────────
# WEBNAMES_API_KEY — API-ключ webnames.ru для acme.sh DNS-01 wildcard TLS.
# Требуется при PLATFORM_CERTBOT_DNS_PLUGIN=webnames.
# Хранится в SOPS-encrypted файле на VPS (/opt/node-configs/secrets/<node>.enc.yaml).
# На VPS: sourced из /run/platform/secrets.env перед step 14 (ssl provision).
# Локально: не требуется (используются dev-certs через mkcert/openssl).
WEBNAMES_API_KEY=*test-webnames-api-key

# ── Proxy (Tor/Privoxy, опционально) ─────────────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
# Список адресов, исключённых из прокси.
# ⚠️ Канонический источник: platform-env.yaml proxy.no_proxy_internal.
#    Этот список должен ⊇ no_proxy_internal — гейт T8.5 валидирует.
# base: внутренние Docker-сервисы; внешние API-хосты добавляются по контексту.
NO_PROXY=localhost,127.0.0.1,.local,postgres,pgbouncer,redis,clickhouse,litellm,langfuse,minio,grafana,prometheus

# ── Monitoring / Observability ───────────────────────────────────────────
# Grafana
GF_SECURITY_ADMIN_USER=admin@ai-platform.local
GF_SECURITY_ADMIN_PASSWORD=testpass
GRAFANA_PORT=3000
# Prometheus
PROMETHEUS_TARGETS_DIR=/opt/platform/prometheus-targets
PROMETHEUS_RULES_DIR=/opt/platform/prometheus-rules
PROMETHEUS_PORT=9090
# Loki (logging backend)
LOKI_PORT=3100
# Infra-metrics exporters
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

# ── Compose Profiles ──────────────────────────────────────────────────────
# Все 13 профилей — активирует все модули при make up (без явного MODULES=)
COMPOSE_PROFILES=postgres,redis,nginx,clickhouse,backup-cron,hermes-agent,monitoring,logging,litellm,langfuse,infra-metrics,minio,status-page

# ── Misc ──────────────────────────────────────────────────────────────────────
# Таймаут проверки зависимостей в секундах (default: 2.0)
DEPENDENCY_CHECK_TIMEOUT=2.0

# PROJECTS_BASE — базовая директория проектов для DeployOrchestrator (default: /opt/projects)
PROJECTS_BASE=/opt/projects
# PLATFORM_DEPLOY_TIMEOUT — таймаут деплоя в секундах для DeliveryChannel (default: 600)
PLATFORM_DEPLOY_TIMEOUT=600

# ══════════════════════════════════════════════════════════════════════════════
# GitHub Actions secrets (NOT .env vars — create in repo Settings → Secrets)
# These are consumed by CI/CD workflows, NOT by docker-compose services.
# ══════════════════════════════════════════════════════════════════════════════
#
# VPS_HOST — SSH hostname/IP for VPS node (used by platform-deploy.yml)
# VPS_SSH_KEY — SSH private key for VPS access (used by platform-deploy.yml)
# CI_DEPLOY_KEY — SSH deploy key for ci-deploy forced-command (used by deploy-project.yml, platform-deploy.yml)
# DOCKER_HUB_USERNAME — Docker Hub username for authenticated pulls (used by platform-test.yml, platform-deploy.yml)
# DOCKER_HUB_TOKEN — Docker Hub PAT for authenticated pulls (used by platform-test.yml, platform-deploy.yml)
# SSH_HOST — SSH hostname passed as workflow_call secret (used by platform-deploy.yml)
# SSH_KEY — SSH private key for ci-deploy passed as workflow_call secret. ≡ CI_DEPLOY_KEY (один ключ, две роли: rsync + forced-command)
# E2E_BASE_URL — Base URL for E2E smoke test health endpoint (used by platform-deploy.yml)
# E2E_GRAFANA_URL — Grafana URL for E2E smoke test health check (used by platform-deploy.yml)
# GHCR_PULL_TOKEN — Fine-grained PAT for ghcr.io read:packages
GHCR_PULL_TOKEN=ghp_test-token-for-ci-only
# GHCR_PUSH_TOKEN — Fine-grained PAT for ghcr.io write:packages (L2 push)
#   Create: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   Repository access: tronyxlab/ai-platform
#   Permissions: Packages → Write
GHCR_PUSH_TOKEN=ci-ghcr-push-token

# GIT_MIRROR_TOKEN — Token for git mirror operations (optional, SSH fallback — used by platform-deploy.yml)
# NODE_HOST_MAP — JSON mapping of node names to SSH hosts, org variable (used by deploy-project.yml)
