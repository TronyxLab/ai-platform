# GREP_SUMMARY: backup-cron crontab schedule 0130-retry 03:00 03:30 04:00 05:00 hourly-wal-sync flock full-backup app-data cleanup retention wal-sync
# region MODULE_CONTRACT
## @purpose  Cron schedule for platform backup jobs (03 §4) + WAL sync (DevPlan 132 W2)
##           + daily spool rescan retry (REF-0009); all jobs flock-guarded
## @scope    Installed to /etc/cron.d/platform-backup in the container
## @invariants
##   - 01:30 UTC — spool-rescan retry (REF-0009): re-upload spool files without
##     .uploaded sentinel (failed nightly upload → off-site copy still created);
##     до 03:00 дампа — не пересекается с ночным окном
##   - 03:00 UTC — full postgres pg_dumpall backup
##   - 03:30 UTC — application data backup (file volumes)
##   - 04:00 UTC — spool cleanup (sentinel-gated, remove ONLY confirmed-uploaded
##     files older than 7 days; REF-0009 BUG-0802 fix)
##   - 05:00 UTC — S3 retention rotation (7/28/90, phase 06 §3)
##   - 10 * * * * — hourly WAL sync: wal_archive → S3 (HEAD→PUT) + safe-delete (132 W2);
##     до 03:00 дампа не пересекается; после успеха upload в S3 локальный retention чистит старьё
##   - Every job wrapped in `flock -n /run/lock/<name>.lock` (REF-0009, SEC-0049
##     flock part / FAIL-0905): overlapping run exits silently instead of racing
##     the same spool/log files. Lock dir /run = tmpfs (compose tmpfs contract).
##   - All scripts log to /var/log/platform/backup/
## @rationale Schedule mirrors 03 §4 spec; cleanup at 04:00 after both backups complete;
##            retry at 01:30 gives a fresh off-site attempt ~25h after the failed nightly
## ⚠️ TRAP[DECISION] · 2026-07-01 · — · Backup sequence order (project→service→node)
## ·   Cron schedule enforces strict order: 01:30 retry, 03:00 postgres (DB-first,
## ·   most critical), 03:30 app-data (files), 04:00 cleanup, 05:00 S3 retention rotation,
## ·   Rev: if backup times grow beyond schedule window, decouple into separate systemd timers
## ·   Rationale: postgres is the slowest and most important backup; run it first
## ·   Rejected: randomize order for fairness — postgres always needs priority
# endregion MODULE_CONTRACT

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# m   h   dom mon dow  command
# [IMP:8][crontab] 01:30 UTC — spool-rescan retry (REF-0009): unuploaded spool files
30  1   *   *   *   root flock -n /run/lock/platform-backup-spool-retry.lock /usr/local/bin/spool-retry-upload.sh >> /var/log/platform/backup/spool-retry.log 2>&1

# [IMP:8][crontab] 03:00 UTC — full postgres backup
0   3   *   *   *   root flock -n /run/lock/platform-backup-postgres.lock /usr/local/bin/backup-postgres.sh >> /var/log/platform/backup/postgres.log 2>&1

# [IMP:8][crontab] 03:30 UTC — application data backup
30  3   *   *   *   root flock -n /run/lock/platform-backup-app-data.lock /usr/local/bin/backup-app-data.sh >> /var/log/platform/backup/app-data.log 2>&1

# [IMP:8][crontab] 04:00 UTC — sentinel-gated spool cleanup (7-day retention, 03 §3 + REF-0009)
0   4   *   *   *   root flock -n /run/lock/platform-backup-cleanup.lock /usr/local/bin/backup-cleanup.sh >> /var/log/platform/backup/cleanup.log 2>&1

# [IMP:8][crontab] 05:00 UTC — S3 retention rotation (7/28/90, phase 06 §3)
0   5   *   *   *   root flock -n /run/lock/platform-backup-retention.lock python3 /usr/local/bin/retention.py >> /var/log/platform/backup/retention.log 2>&1

# [IMP:8][crontab] 10 * * * * UTC — hourly WAL sync → S3 (HEAD→PUT, safe-delete, 132 W2)
# · WAL_ARCHIVE_DIR монтируется как wal-archive volume (/var/lib/platform/wal-archive)
# · Run до 03:00 дампа — не пересекается; после upload локальный retention чистит старьё
10  *   *   *   *   root flock -n /run/lock/platform-wal-sync.lock python3 /usr/local/bin/wal_sync.py >> /var/log/platform/backup/wal-sync.log 2>&1

# ⚠️ TRAP[BUG] · 2026-07-18 · P1 · Cron paths used /opt/core/ instead of /opt/platform/core/
# · Symptom: cron jobs silently failed — /opt/core/ does not exist on VPS; only /opt/platform/ exists
# · Root: path written before PLATFORM_ROOT canonicalization (core/lib/paths.sh → PLATFORM_ROOT=/opt/platform)
# · Fix: replaced /opt/core/ → /opt/platform/core/ per paths.sh canonical root
# · Prevention: gate test_gate_path_consistency scans repo for orphan /opt/core/ references
