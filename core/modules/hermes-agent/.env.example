# region MODULE_CONTRACT
## @purpose     Template for hermes-agent test credentials — copy to .env and fill with real values
## @scope       E2E tests (test_e2e_*.py), component tests (test_component_hermes.py)
## @invariants  NEVER commit .env with real values · chmod 600 · all values are placeholders
##              Production secrets on VPS: /run/platform/secrets.env (tmpfs, AGE-decrypted)
##              Platform config on VPS: /opt/platform/.env (includes API keys, credentials)
##              Agent action: first connect to VPS → read secrets.env via SSH
##                ssh root@HOST "cat /run/platform/secrets.env 2>/dev/null || echo 'NOT_FOUND'"
##                then merge with /opt/platform/.env for full production secrets set
## @changes     CREATED: 2026-07-03 | Security fix C1 — placeholder-only template
##              UPDATED: 2026-07-16 | T2 drift-convergence — sync with .env, +11 vars, fix LITELLM typo, proxy→comment
# endregion MODULE_CONTRACT

# GREP_SUMMARY: env-example template hermes grafana langfuse openai deepseek placeholder

# ── Grafana Admin (used by conftest::grafana_credentials) ──────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password-here

# ── Hermes Dashboard (used by test_e2e_hermes_api.py + test_component_hermes.py) ──
# ⚠️ compose использует HERMES_DASHBOARD_PASSWORD (не HERMES_DASHBOARD_BASIC_AUTH_PASSWORD!)
# ·   HERMES_DASHBOARD_BASIC_AUTH_PASSWORD — это имя ВНУТРИ контейнера (куда compose мапит).
# ·   В .env нужно указывать HERMES_DASHBOARD_PASSWORD — compose сам преобразует.
# ·   Ошибка: если указать только BASIC_AUTH_PASSWORD, compose упадёт с "required in secrets.env".
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=your-dashboard-password-here

# ── Langfuse (used by conftest::langfuse_credentials) ──────────────────────
LANGFUSE_INIT_USER_PASSWORD=your-langfuse-password-here
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_ORG_ID=your-langfuse-org-id-here
LANGFUSE_INIT_PROJECT_ID=your-langfuse-project-id-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# ── LLM API Keys (used by test_integration_hermes_llm.py) ──────────────────
# ⚠️ TRAP[SECURITY] · 2026-07-03 · Placeholder-ключи — НЕ ИСПОЛЬЗОВАТЬ реальные здесь
# · Получить ключи из macOS Keychain:
# ·   export DEEPSEEK_API_KEY=$(security find-generic-password -w -a "$USER" -s "deepseek-api-key")
# ·   export OPENAI_API_KEY=$(security find-generic-password -w -a "$USER" -s "openai-api-key")
# ⚠️ OPENAI_API_KEY должен совпадать с LITELLM_MASTER_KEY в production (см. TRAP[INCIDENT] в docker-compose.base.yml)
# ·   Hermes использует OPENAI_API_KEY для аутентификации в LiteLLM proxy.
# ·   Если ключи разные → Hermes не может вызвать LiteLLM, падает на chat completions.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
LITELLM_MASTER_KEY=sk-your-litellm-master-key-here
GLM_API_KEY=your-glm-api-key-here

# ── Telegram Bot (used by Hermes telegram interface) ──────────────────────
# ⚠️ Must set TELEGRAM_ALLOWED_USERS if TELEGRAM_BOT_TOKEN is configured
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=your-telegram-user-id-here

# ── Proxy (Tor/Privoxy) ───────────────────────────────────────────────
# HTTP(S)_PROXY — см. proxy-сессию 016

# ── Image override (optional — compose default: ghcr.io/tronyxlab/hermes-agent-context:latest) ──
# CONTEXT_IMAGE=ghcr.io/tronyxlab/hermes-agent-context:latest

# ── Dependency Health Check (used by Hermes /ready endpoint) ──
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432
REDIS_HOST=redis
REDIS_PORT=6379
LITELLM_HEALTH_URL=http://litellm:4000/health
DEPENDENCY_CHECK_TIMEOUT=2.0

# ── Additional required env vars (from compose files — no default) ─────────
POSTGRES_PASSWORD=test-pg-pwd
S3_BUCKET=your-s3-bucket-name-here
NEXTAUTH_SECRET=ci-test-nextauth-secret-32-chars-min!!
SALT=your-salt-value-here

# ── ClickHouse (test credentials — not production secrets) ─────────────────
CLICKHOUSE_PASSWORD=your-clickhouse-password-here

# ── MinIO local S3 (test credentials — not production secrets) ────────────
MINIO_ROOT_USER=your-minio-root-user-here
MINIO_ROOT_PASSWORD=your-minio-root-password-here
