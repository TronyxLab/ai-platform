# region MODULE_CONTRACT
## @purpose     Template for required environment variables for base agent
## @scope       LLM API keys, Telegram credentials, dashboard basic auth, port overrides
## @invariants
##   - NEVER commit this file with real values (see .gitignore)
##   - chmod 600 after filling
##   - All values are __PLACEHOLDER__ — MUST be replaced before deployment
##   - BASE_IMAGE points to hermes-agent-base:latest (platform base image, L1)
## @changes     LAST_CHANGE: 2026-07-10 | BASE_IMAGE updated: stale platform image name → hermes-agent-base:latest
# endregion MODULE_CONTRACT

# GREP_SUMMARY: env.example base-agent secrets template

# ── LLM Provider API Keys ──────────────────────────────────────────────────────
# DeepSeek API key for model inference
DEEPSEEK_API_KEY=__DEEPSEEK_API_KEY__

# OpenRouter API key (fallback / multi-model routing)
OPENROUTER_API_KEY=__OPENROUTER_API_KEY__

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=__TELEGRAM_BOT_TOKEN__

# Comma-separated list of allowed Telegram user IDs (numeric, e.g. "123456,789012")
TELEGRAM_ALLOWED_USERS=__TELEGRAM_ALLOWED_USERS__

# ── Dashboard Basic Auth ───────────────────────────────────────────────────────
# Username for the Hermes dashboard login
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin

# Password for the Hermes dashboard login
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=__CHANGE_ME__

# ── Ports (optional overrides) ─────────────────────────────────────────────────
# Desktop API port exposed on host (default: 8642)
HERMES_DESKTOP_PORT=8642

# Dashboard port exposed on host (default: 9119)
HERMES_DASHBOARD_PORT=9119

# ── Base image tag (optional) ──────────────────────────────────────────────────
# Override the base agent image tag (L0 upstream — единый образ собирается из source,
# DevPlan 002: L1 hermes-agent-base схлопнут в L2 hermes-agent-context)
BASE_IMAGE=nousresearch/hermes-agent:v2026.8.3
