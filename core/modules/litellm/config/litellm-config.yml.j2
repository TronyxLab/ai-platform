## @purpose  LiteLLM configuration — model_list, fallbacks, general_settings for the LiteLLM proxy
## @scope    Generated from policy.yaml by config_renderer.py. Consumed by LiteLLM container at startup.
## @invariants   AUTO-GENERATED — no manual edits. Regenerated on node-update and project deploy.
## @rationale Machine-readable LiteLLM config with Jinja2 template ensures type-safe generation of model_list and fallbacks from policy.yaml.
# endregion MODULE_CONTRACT
# GREP_SUMMARY: litellm-config, auto-generated, model_list, fallbacks, deepseek, policy
# STRUCTURE: ▶ general_settings → ◇ model_list[N]: alias → fallback → ◇ litellm_settings + fallbacks → ⎋

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  disable_master_key_returned: true

model_list:
{% for model in model_list %}
  - model_name: {{ model.name }}
    litellm_params:
      model: {{ model.litellm_model }}
      api_key: {{ model.api_key }}
{% if model.mode %}
      mode: {{ model.mode }}
{% endif %}
    model_info:
      supported_environments:
        - production
        - development
{% if model.access_groups %}
      access_groups:
{% for group in model.access_groups %}
        - {{ group }}
{% endfor %}
{% endif %}
{% endfor %}

litellm_settings:
  num_retries: {{ settings.num_retries }}
  request_timeout: {{ settings.request_timeout }}
  drop_params: {{ settings.drop_params | lower }}
{% if settings.success_callback %}
  success_callback:
{% for cb in settings.success_callback %}
    - {{ cb }}
{% endfor %}
{% endif %}
{% if settings.failure_callback %}
  failure_callback:
{% for cb in settings.failure_callback %}
    - {{ cb }}
{% endfor %}
{% endif %}
{% if fallbacks %}
  fallbacks:
{% for fallback in fallbacks %}
    - {{ fallback.primary }}: {{ fallback.fallback }}
{% endfor %}
{% endif %}
