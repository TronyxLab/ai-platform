{
  "title": "DORA CI/CD Metrics",
  "description": "DORA metrics dashboard: Deploy Frequency, Lead Time, MTTR, Change Failure Rate — sourced from GitHub Actions API",
  "uid": "dora-ci-cd",
  "tags": ["ai-platform", "dora", "ci-cd", "github-actions"],
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "grafanagithubdatasource",
        "current": { "selected": true, "text": "GitHub", "value": "grafanagithubdatasource" },
        "hide": 0
      },
      {
        "name": "repository",
        "type": "constant",
        "query": "Tronyx161/ai-platform",
        "current": { "selected": true, "text": "Tronyx161/ai-platform", "value": "Tronyx161/ai-platform" },
        "label": "Repository",
        "hide": 0
      },
      {
        "name": "workflow",
        "type": "constant",
        "query": "platform-test.yml",
        "current": { "selected": true, "text": "platform-test.yml", "value": "platform-test.yml" },
        "label": "CI Workflow",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Deploy Frequency",
      "description": "Number of successful deployments per day (main branch CI runs)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "grafanagithubdatasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "repository": "${repository}",
          "workflow": "${workflow}",
          "branch": "main",
          "result": "success",
          "format": "timeseries"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "deploys",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 5 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "title": "Lead Time for Changes",
      "description": "Average time from PR merge to deployment completion",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "grafanagithubdatasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "repository": "${repository}",
          "workflow": "${workflow}",
          "branch": "main",
          "format": "timeseries"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 600 },
              { "color": "red", "value": 1800 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "title": "Mean Time to Recovery (MTTR)",
      "description": "Average time to resolve failed deployments (time between first failure and first success)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "grafanagithubdatasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "repository": "${repository}",
          "workflow": "${workflow}",
          "branch": "main",
          "result": "success",
          "format": "timeseries"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 900 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "title": "Change Failure Rate (CFR)",
      "description": "Percentage of deployments resulting in failure (failed / total × 100)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "grafanagithubdatasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "repository": "${repository}",
          "workflow": "${workflow}",
          "branch": "main",
          "format": "timeseries"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "title": "Workflow Runs (30d)",
      "description": "GitHub Actions workflow runs over time — green = success, red = failure",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "grafanagithubdatasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "repository": "${repository}",
          "workflow": "${workflow}",
          "branch": "main",
          "format": "timeseries"
        }
      ],
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "GitHub Actions",
      "type": "link",
      "url": "https://github.com/${repository}/actions",
      "targetBlank": true
    }
  ]
}
