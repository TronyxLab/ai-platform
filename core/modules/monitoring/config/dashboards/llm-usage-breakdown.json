{
  "title": "LLM Usage Breakdown",
  "description": "Detailed LLM usage analytics: per-model, per-session, per-user breakdowns",
  "uid": "llm-usage-breakdown",
  "tags": ["ai-platform", "llm", "usage", "cost"],
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "model",
        "type": "query",
        "query": "label_values(litellm_proxy_total_requests_metric_total, requested_model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "Requests by Model (Time Series)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(litellm_proxy_total_requests_metric_total{requested_model=~\"$model\"}[5m])) by (requested_model)",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Cost Accumulation (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(litellm_spend_metric_total{requested_model=~\"$model\"}[5m])) by (requested_model)",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "title": "Token Usage by Model",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(litellm_total_tokens_metric_total{requested_model=~\"$model\"}[24h])) by (requested_model)",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "title": "Cost Distribution by Model",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(litellm_spend_metric_total{requested_model=~\"$model\"}[7d])) by (requested_model)",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "displayLabels": ["name", "percent", "value"]
      }
    },
    {
      "title": "Top Users by Cost (1h)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "topk(10, sum(increase(litellm_spend_metric_total[1h])) by (user))",
          "legendFormat": "{{user}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "user": "User",
              "Value": "Cost (1h)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "title": "Model Latency Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(litellm_llm_api_latency_metric_bucket{requested_model=~\"$model\"}[5m])) by (le)",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "heatmap": {
        "yBucketNumber": 10,
        "yBucketSize": null,
        "yAxis": { "unit": "s" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1
}
