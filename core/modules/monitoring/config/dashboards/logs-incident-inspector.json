{
  "title": "Logs & Incident Inspector",
  "description": "Log exploration and incident investigation: search by session_id, correlate LLM calls with agent logs",
  "uid": "logs-incident-inspector",
  "tags": ["ai-platform", "logs", "incident", "session"],
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "session_id",
        "type": "textbox",
        "label": "Session ID",
        "query": "",
        "description": "Enter session ID to filter logs for incident investigation",
        "current": { "text": "", "value": "" },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(container)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "Log Volume by Container",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by(container) (count_over_time({container=~\"$container\"}[$__interval]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "title": "LLM Logs (session_id filter)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=\"litellm\"} | session_id=\"$session_id\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "title": "Hermes Agent Logs (session_id filter)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=\"hermes-agent\"} | session_id=\"$session_id\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "title": "Nginx Access Logs (status filter)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"nginx\"} | status >= 400",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "title": "All Container Logs (live tail)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "title": "Error Distribution by Container",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by(container) (count_over_time({container=~\"$container\"} | level=~\"error|critical\" [$__range]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {
        "displayLabels": ["name", "percent", "value"]
      }
    },
    {
      "title": "Timeline: LLM Call Chain for Session",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=\"litellm\"} | session_id=\"$session_id\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "alignValue": "center",
        "rowHeight": 0.9
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1
}
