# Platform default vhost — HTTP redirect to HTTPS + default static page
# GREP_SUMMARY: nginx vhost default platform http-redirect https static-root error-pages
# This file is managed by core; do NOT edit manually.
# For node-specific overrides, use node-configs overlay.
#
# ⚠️ TRAP[BUG] · 2026-06-07 · HI · HTTPS-блок всегда активен в шаблоне — сертификат
# · выпускается acme.sh DNS-01, не модифицирует конфиг nginx. При первом бутстрапе
# · деплоится platform-http.conf (HTTP-only), затем после выпуска wildcard-сертификата
# · заменяется на этот HTTPS-конфиг.
#
# ⚠️ TRAP[BUG] · 2026-07-16 · HI · D11/D12: ${PLATFORM_DOMAIN} монтировался в контейнер без подстановки
# · Symptom: nginx crash `unknown "platform_domain" variable`; хак-замена на $host сломала vhost-роутинг (D12)
# · Root: Docker-путь монтировал конфиги в conf.d напрямую; server_name не поддерживает переменные
# · Fix: конфиги монтируются в /etc/nginx/templates/*.conf.template; entrypoint образа рендерит envsubst'ом (только определённые env) в conf.d
# · Prevention: gate tests/gates/test_gate_nginx_domain_contract.py

# region PLATFORM_DEFAULT_VHOST

# ── Default document root (fallback static page) ──────────────────────────
# Place your app proxy_pass directives in a separate include or override this
# file via node-configs overlay.
root /var/www/platform-default;
index index.html;

# ── HTTP → HTTPS redirect ─────────────────────────────────────────────────
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Redirect all HTTP to HTTPS (preserve host and path)
    location / {
        return 301 https://$host$request_uri;
    }

    # ACME challenge (used for certificate renewal verification)
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
}

# ── HTTPS: www → non-www redirect ─────────────────────────────────────────
# 🧐 TRAP[DECISION] · 2026-07-15 · — · nginx:1.28 «listen ... http2» deprecated in favour of «http2 on;»
# ·   nginx 1.25+ deprecated «listen ... http2» — use «listen ssl; http2 on;» instead.
# ·   Rejected: keep old syntax (warns in 1.28, error in future versions).
# ·   Rev: nginx 1.24 backport on Ubuntu/Debian did not recognize «http2 on;» — no longer relevant.
# ·   Wildcard «server_name www.*;» невалиден — исправлено на явный server_name.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${PLATFORM_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_DOMAIN}/privkey.pem;

    # ── SSL configuration (inline) ──
    ssl_session_cache    shared:le_nginx_SSL:10m;
    ssl_session_timeout  1d;
    ssl_session_tickets  off;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers          ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;

    return 301 https://${PLATFORM_DOMAIN}$request_uri;
}

# ── HTTPS: primary vhost (catch-all / apex fallback) ───────────────────────
# ⚠️ TRAP[DECISION] · 2026-07-17 · MED · apex-ownership = catch-all (overlay wins by exact match)
# · Changed: server_name ${PLATFORM_DOMAIN} → server_name _
# · Rationale: overlay vhost (conf.d/overlay/tronyx.ru.conf) uses exact server_name tronyx.ru;
#   nginx server selection: exact match > default_server. Overlay wins when present;
#   this block serves as fallback static page when no overlay is deployed.
# · Rev: if architecture invalidates this decision or overlay deployment pattern changes
# · Rejected: NGINX_APEX_SERVER_NAME env var (adds env cascade across 4 files w/o benefit)
# · Rejected: overlay-replaces-entirely (loses fallback placeholder page)
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_DOMAIN}/privkey.pem;

    # ── SSL configuration (inline) ──
    ssl_session_cache    shared:le_nginx_SSL:10m;
    ssl_session_timeout  1d;
    ssl_session_tickets  off;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers          ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;

    # ── Default static root (placeholder until apps are deployed) ──────
    root /var/www/platform-default;
    index index.html;

    # ── Custom error pages ─────────────────────────────────────────────
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;

    location = /404.html {
        root /var/www/platform-default/error-pages;
        internal;
    }

    location = /50x.html {
        root /var/www/platform-default/error-pages;
        internal;
    }

    location = /maintenance.html {
        root /var/www/platform-default/error-pages;
        internal;
    }

    # ── Default catch-all: close connection for unregistered subdomains ─
    # ⚠️ TRAP[DECISION] · 2026-07-18 · HI · default_server returns 444 (no response)
    # · Previously: served placeholder "Platform Node" static page → any *.tronyx.ru resolved.
    # · Changed: return 444 — nginx closes TCP connection without HTTP response.
    # ·   Registered subdomains (overlay vhosts) match by exact server_name and win over default_server.
    # ·   Unregistered subdomains get nothing — no information disclosure.
    # · Rev: if 444 causes issues with monitoring probes, switch to 403.
    #
    # ── Status-page moved to platform-vhost.conf.template (platform.tronyx.ru) ─────
    # ⚠️ TRAP[DECISION] · 2026-07-20 · — · Status-page отделён в отдельный vhost
    # · Changed: status-page перенесён из default_server в platform-vhost.conf.template
    # ·   с server_name platform.${PLATFORM_DOMAIN} (exact match).
    # ·   Apex tronyx.ru возвращён к overlay (tronyx_site) через return 444 по умолчанию.
    # · Reason: stealth 444 на apex — неочевидное поведение; отдельный поддомен чище.
    # · Rev: если 444 на apex блокирует CI-пробы — заменить на 403 или static page.
    location / {
        return 444;
    }

    # ACME challenge (used for certificate renewal verification)
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    # ── Security headers ───────────────────────────────────────────────────
    include /etc/nginx/includes/security-headers.conf;

    # ── Rate limiting (dynamic zone: 10 r/s, burst 20) ─────────────────────
    limit_req zone=dynamic burst=20 nodelay;
    limit_req_status 429;
}

# endregion PLATFORM_DEFAULT_VHOST
