# GREP_SUMMARY: platform-secrets systemd unit boot decrypt sops age autogen ensure secrets-manager reboot
# STRUCTURE: Before(docker.service) → EnvironmentFile(age-key) + PYTHONPATH → ExecStart(decrypt_secrets.py) → ExecStartPost(secrets_manager ensure autogen) → RequiredBy(docker.service)
[Unit]
Description=Platform secrets decryption + autogen — generates /var/lib/platform/run/secrets.env from encrypted SOPS file and auto-generates missing tier=generated secrets
Before=docker.service
Wants=network-online.target
After=network-online.target
# ⚠️ TRAP[DECISION] · 2026-08-13 · — · Requires (не Wants) + RequiresMountsFor=/etc/platform (DevPlan 162 W3-1 b)
# · Rejected: Requires→Wants (docker стартует при failed decrypt → контейнеры с секретами получат
# ·   пустые env → CrashLoop с невнятными ошибками) — invisible failure, хуже явного «docker не стартует»
# · Reason: DevPlan 162 W3-1 v2 оставляет Requires; RequiresMountsFor гарантирует, что /etc/platform
# ·   (AGE-ключ EnvironmentFile) смонтирован до старта сервиса → юнит стабильно active (exited)
# · Rev: если decrypt станет non-critical для docker — пересмотреть Wants + убрать RequiresMountsFor
RequiresMountsFor=/etc/platform

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/platform/age-key.txt
Environment=SECRETS_FILE=/opt/platform/secrets/secrets.enc.yaml
Environment=SECRETS_ENV_FILE=/var/lib/platform/run/secrets.env
# Plan 012 T1 (F-037): PYTHONPATH в самом юните — после reboot decrypt_secrets.py
# импортирует core.internal.* без ручных drop-in обходов (one-command bootstrap).
Environment=PYTHONPATH=/opt/platform
ExecStart=/opt/platform/core/internal/secrets/decrypt_secrets.py
ExecStartPost=/bin/sh -c 'echo "[IMP:9][platform-secrets] Secrets decrypted to /var/lib/platform/run/secrets.env" >&2'
# ⚠️ launch-validation asi-team-vps (P0): reboot-путь обязан воспроизводить φ4 (decrypt + ensure).
# · decrypt пишет ТОЛЬКО sops + ci_default (16 ключей); tier=generated/source=autogen секреты
# · (ENCRYPTION_KEY, LITELLM_MASTER_KEY, NEXTAUTH_SECRET, REDIS_PASSWORD, SALT, LANGFUSE_*,
# · API_SERVER_KEY) генерируются secrets_manager.ensure — иначе после reboot secrets.env = 16
# · ключей → compose ${ENCRYPTION_KEY:?} падает (deploy-modules.sh exit 10).
# · Ensure идемпотентен: генерирует ТОЛЬКО missing, существующие значения НЕ перезаписывает
# · (инвариант 2 secrets_manager); manifest — GENERATED core/secrets-manifest.yaml (доставлен с core/).
# · Порядок гарантирует systemd: ExecStartPost выполняется после успешного ExecStart (decrypt).
# · Ensure пишет в /var/lib/platform/run (secrets.env + .htpasswd-platform) — /var вне зоны
# · ProtectSystem=full (/usr,/boot,/etc RO) и PrivateTmp → ReadWritePaths не требуется.
# · NODE_NAME в юните не задан → sops --set persistence пропускается (чистая догенерация missing).
ExecStartPost=python3 -m core.internal.bootstrap.lifecycle.secrets_manager ensure --manifest /opt/platform/core/secrets-manifest.yaml --secrets-env /var/lib/platform/run/secrets.env
User=root
Group=root
PrivateTmp=yes
ProtectSystem=full
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
RequiredBy=docker.service
