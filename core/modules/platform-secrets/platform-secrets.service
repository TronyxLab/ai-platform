[Unit]
Description=Platform secrets decryption — generates /run/platform/secrets.env from encrypted SOPS file
Before=docker.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/platform/age-key.txt
Environment=SECRETS_FILE=/opt/platform/secrets/secrets.enc.yaml
Environment=SECRETS_ENV_FILE=/run/platform/secrets.env
ExecStart=/opt/platform/core/internal/secrets/decrypt-secrets.sh
ExecStartPost=/bin/sh -c 'echo "[IMP:9][platform-secrets] Secrets decrypted to /run/platform/secrets.env" >&2'
User=root
Group=root
PrivateTmp=yes
ProtectSystem=full
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
