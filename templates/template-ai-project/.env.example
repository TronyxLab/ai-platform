# ── Platform Services (provided by ai-platform) ──────────────────────────────
# Все переменные ниже генерируются в .env.platform командой `make sync-env`.
# Этот файл — reference; bot/сервис-проекты обычно используют подмножество.

# Domain (если нужен exposed-домен)
PLATFORM_DOMAIN=test.local

# LiteLLM (proxy-net) — LLM только через сеть платформы (бриф §7)
PLATFORM_LITELLM_URL=http://litellm:4000

# Langfuse (proxy-net) — трейсы LLM-вызовов (W3 D11)
PLATFORM_LANGFUSE_URL=http://langfuse:3001

# Postgres (платформенный) — kernel_* + cap_* состояние (R15)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/{{PROJECT_NAME}}

# Docker networks (external)
PLATFORM_PROXY_NET=proxy-net

# No-proxy (internal services)
PLATFORM_NO_PROXY=localhost,127.0.0.1,.local

# Health/metrics порт ядра (совпадает с monitoring.metrics_port, бриф §7)
HEALTH_PORT=8787
