# GENERATED by template-ai-project — ручные правки затираются практиками
# GREP_SUMMARY: Dockerfile template-ai-project node 22 alpine build run non-root health dist
# STRUCTURE: node:22-alpine(build: npm ci → npm run build) → node:22-alpine(run: npm ci --omit=dev + dist) → non-root USER node
# region MODULE_CONTRACT
## @purpose  Single-stage Docker build проекта-бота (template-ai-project, W3 D9; бриф §7):
##           node:22-alpine, production-зависимости + собранный dist/, non-root USER.
## @scope    Проекты AI Project (боты/сервисы); runtime — dist/index.js (composition root)
## @invariants
##   - Build stage: npm ci (полный, нужен tsc) → npm run build → dist/
##   - Run stage: npm ci --omit=dev (только runtime-зависимости) + COPY dist
##   - USER node — non-root (node:22-alpine имеет пользователя node)
##   - config/ и content/ НЕ в образе (volume, .dockerignore) — образ неизменяем (§7)
##   - HEALTH_PORT контейнера не EXPOSE-хадкодится наружу — healthcheck в docker-compose
## @rationale Минимум для деплоя бота (D9): никаких nginx/vite/вторых цепочек — CMD node dist/index.js
# endregion MODULE_CONTRACT

FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist ./dist
RUN chown -R node:node /app
USER node
# Health/metrics порт ядра (healthPort из config/kernel.json; healthcheck — в compose)
EXPOSE 8787
CMD ["node", "dist/index.js"]
