# ── Platform Services (provided by ai-platform) ──────────────────────────────
# Все переменные ниже генерируются в .env.platform командой `make sync-env`.
# Этот файл — reference: значения соответствуют платформенному стеку
# (platform-env.yaml#provides). Для локальной разработки без платформенного
# стека используйте `docker compose -f docker-compose.dev.yml up -d`.

# PostgreSQL (shared-db-net, pgbouncer-пул)
PLATFORM_POSTGRES_HOST=pgbouncer
PLATFORM_POSTGRES_PORT=6432
PLATFORM_POSTGRES_DSN=postgresql://user:pass@pgbouncer:6432/db

# Redis (shared-cache-net)
PLATFORM_REDIS_HOST=redis
PLATFORM_REDIS_PORT=6379
PLATFORM_REDIS_URL=redis://redis:6379/0

# LiteLLM (proxy-net)
PLATFORM_LITELLM_URL=http://litellm:4000

# Langfuse (proxy-net)
PLATFORM_LANGFUSE_URL=http://langfuse:3001

# MinIO (proxy-net)
PLATFORM_MINIO_URL=http://minio:9000

# ClickHouse (shared-db-net)
PLATFORM_CLICKHOUSE_HOST=clickhouse
PLATFORM_CLICKHOUSE_PORT=8123
PLATFORM_CLICKHOUSE_DSN=clickhouse://clickhouse:8123/db

# Domain
PLATFORM_DOMAIN=test.local

# Docker networks (external)
PLATFORM_PROXY_NET=proxy-net
PLATFORM_SHARED_DB_NET=shared-db-net
PLATFORM_SHARED_CACHE_NET=shared-cache-net

# No-proxy (internal services)
PLATFORM_NO_PROXY=localhost,127.0.0.1,.local
